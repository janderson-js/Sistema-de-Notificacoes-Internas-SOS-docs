{
  "manifest_version": 3,
  "name": "Notificações da Equipe",
  "version": "2.0.0",
  "description": "Recebe avisos do supervisor mesmo usando fone de ouvido, via popup visual na tela.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/vendor/firebase-app-compat.js",
        "content/vendor/firebase-firestore-compat.js",
        "content/firebase-config.js",
        "content/overlay-ui.js",
        "content/firestore-listener.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Notificações da Equipe"
  }
}
